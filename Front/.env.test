# Environment for `vitest` runs (mode: test).
#
# jsdom runs at http://localhost:5173 (see vite.config.ts). A relative API
# base URL keeps every request same-origin, so jsdom never emits CORS
# preflights that MSW handlers would have to answer. With the absolute
# fallback (http://localhost:3000/api/v1) each authenticated request becomes
# cross-origin, MSW intercepts an unhandled OPTIONS preflight and the whole
# suite fails on a clean checkout (no local .env.local).
VITE_API_BASE_URL=/api/v1
