/**
 * ═══════════════════════════════════════════════════════════════════
 * DATABASE SCHEMA — PRISMA
 * ═══════════════════════════════════════════════════════════════════
 * Database: PostgreSQL
 * ORM: Prisma Client
 * Models:
 * 1. User               — System users (agents and administrators)
 * 2. Property           — Real estate properties
 * 3. Photo              — Property photos
 * 4. RevokedToken       — Revoked JWT blocklist
 * 5. PasswordResetToken — Temporary password reset tokens
 * Enums:
 * - Role:           ADMIN, PARTNER
 * - Category:       House, Apartment, Commercial
 * - PropertyType:   Sale, Rent
 * - PropertyStatus: Active, Inactive
 * ═══════════════════════════════════════════════════════════════════
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
}

enum AuditScope {
  SECURITY
  BUSINESS
}

enum Category {
  House
  Apartment
  Commercial
}

enum PropertyType {
  Sale
  Rent
}

enum PropertyStatus {
  Active
  Inactive
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @map("first_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash")
  phone        String  @db.VarChar(20)
  photoUrl     String? @map("photo_url")
  role         Role    @default(PARTNER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Security boundary: JWTs issued before this instant are rejected.
  passwordChangedAt DateTime? @map("password_changed_at")

  // When true, the user must define a new password before using the API again.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  properties          Property[]
  revokedTokens       RevokedToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([createdAt, id])
  @@map("users")
}

model Property {
  id            Int            @id @default(autoincrement())
  agentId       Int            @map("agent_id")
  code          String         @unique @db.VarChar(50)
  category      Category
  city          String         @db.VarChar(100)
  state         String         @db.VarChar(100)
  address       String         @db.Text
  price         Decimal        @db.Decimal(12, 2)
  description   String?        @db.Text
  bathrooms     Int
  bedrooms      Int
  parkingSpaces Int            @map("parking_spaces")
  type          PropertyType
  squareMeters  Decimal        @map("square_meters") @db.Decimal(10, 2)
  status        PropertyStatus @default(Active)

  apartmentFloor Int?     @map("apartment_floor")
  hasElevator    Boolean? @map("has_elevator")
  hasPowerPlant  Boolean? @map("has_power_plant")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent  User    @relation(fields: [agentId], references: [id])
  photos Photo[]

  @@index([agentId])
  @@map("properties")
}

model Photo {
  id         Int     @id @default(autoincrement())
  propertyId Int     @map("property_id")
  imageUrl   String  @map("image_url")
  isCover    Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("photos")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Persistent brute-force protection keyed by the submitted email, including
// emails that do not belong to any account. Because the row exists for unknown
// emails too, a locked response never reveals whether an account exists.
model LoginAttempt {
  email          String    @id @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("login_attempts")
}

// Append-only security and business activity log. It deliberately has no
// foreign keys so deleting a user never deletes the history of their actions.
model AuditLog {
  id         Int        @id @default(autoincrement())
  scope      AuditScope
  actorId    Int?       @map("actor_id")
  actorRole  Role?      @map("actor_role")
  actorEmail String?    @map("actor_email") @db.VarChar(255)
  action     String     @db.VarChar(80)
  entityType String?    @map("entity_type") @db.VarChar(40)
  entityId   Int?       @map("entity_id")
  changes    Json?
  ip         String?    @db.VarChar(45)
  userAgent  String?    @map("user_agent") @db.VarChar(512)
  requestId  String?    @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([scope, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
