/**
 * ═══════════════════════════════════════════════════════════════════
 * DATABASE SCHEMA — PRISMA
 * ═══════════════════════════════════════════════════════════════════
 * Database: PostgreSQL
 * ORM: Prisma Client
 * Models:
 * 1. User               — System users (agents and administrators)
 * 2. Property           — Real estate properties
 * 3. Photo              — Property photos
 * 4. RevokedToken       — Revoked JWT blocklist
 * 5. PasswordResetToken — Temporary password reset tokens
 * Enums:
 * - Role:           ADMIN, PARTNER
 * - Category:       House, Apartment, Commercial
 * - PropertyType:   Sale, Rent
 * - PropertyStatus: Active, Inactive
 * ═══════════════════════════════════════════════════════════════════
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
}

enum Category {
  House
  Apartment
  Commercial
}

enum PropertyType {
  Sale
  Rent
}

enum PropertyStatus {
  Active
  Inactive
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @map("first_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  email        String  @unique @db.VarChar(255)
  passwordHash String  @map("password_hash")
  phone        String  @db.VarChar(20)
  photoUrl     String? @map("photo_url")
  role         Role    @default(PARTNER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties Property[]

  @@map("users")
}

model Property {
  id            Int            @id @default(autoincrement())
  agentId       Int            @map("agent_id")
  code          String         @unique @db.VarChar(50)
  category      Category
  city          String         @db.VarChar(100)
  state         String         @db.VarChar(100)
  address       String         @db.Text
  price         Decimal        @db.Decimal(12, 2)
  description   String?        @db.Text
  bathrooms     Int
  bedrooms      Int
  parkingSpaces Int            @map("parking_spaces")
  type          PropertyType
  squareMeters  Decimal        @map("square_meters") @db.Decimal(10, 2)
  status        PropertyStatus @default(Active)

  apartmentFloor Int?     @map("apartment_floor")
  hasElevator    Boolean? @map("has_elevator")
  hasPowerPlant  Boolean? @map("has_power_plant")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  agent  User    @relation(fields: [agentId], references: [id])
  photos Photo[]

  @@map("properties")
}

model Photo {
  id         Int     @id @default(autoincrement())
  propertyId Int     @map("property_id")
  imageUrl   String  @map("image_url")
  isCover    Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("password_reset_tokens")
}
