/**
 * ═══════════════════════════════════════════════════════════════════
 * DATABASE SCHEMA — PRISMA
 * ═══════════════════════════════════════════════════════════════════
 * Database: PostgreSQL
 * ORM: Prisma Client
 * Models:
 * 1. User               — System users (agents and administrators)
 * 2. Property           — Captured real estate properties
 * 3. Photo              — Property photos stored in object storage
 * 4. PropertyPhotoBatch — Temporary pre-creation photo upload session
 * 5. PropertyPhotoUpload— Validated photo waiting to be attached
 * 6. RevokedToken       — Revoked JWT blocklist
 * 7. PasswordResetToken — Temporary password reset tokens
 * Enums:
 * - Role:           ADMIN, PARTNER
 * - PropertyType:   HOUSE, APARTMENT, TOWNHOUSE, LAND, COMMERCIAL, OFFICE, WAREHOUSE, FARM
 * - ListingType:    SALE, RENT
 * - PropertyStatus: ACTIVE, PAUSED, CLOSED
 * - Currency:       USD
 * - PropertyPhotoBatchStatus:  OPEN, CONSUMED, EXPIRED
 * - PropertyPhotoUploadStatus: READY, CONSUMED
 * ═══════════════════════════════════════════════════════════════════
 */

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PARTNER
}

enum AuditScope {
  SECURITY
  BUSINESS
}

enum PropertyType {
  HOUSE
  APARTMENT
  TOWNHOUSE
  LAND
  COMMERCIAL
  OFFICE
  WAREHOUSE
  FARM
}

enum ListingType {
  SALE
  RENT
}

enum PropertyStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum Currency {
  USD
}

enum PropertyPhotoBatchStatus {
  OPEN
  CONSUMED
  EXPIRED
}

enum PropertyPhotoUploadStatus {
  READY
  CONSUMED
}

enum EmailType {
  INVITATION
  PASSWORD_RESET
  EMAIL_CHANGE_NOTICE
  ACCOUNT_STATUS_NOTICE
}

enum EmailOutboxStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model User {
  id           Int     @id @default(autoincrement())
  firstName    String  @map("first_name") @db.VarChar(100)
  lastName     String  @map("last_name") @db.VarChar(100)
  email        String  @unique @db.Citext
  passwordHash String  @map("password_hash")
  phone        String  @db.VarChar(20)
  photoUrl     String? @map("photo_url")
  role         Role    @default(PARTNER)

  // Deactivated accounts keep all their history but cannot sign in or use
  // existing sessions. ADMIN users can reactivate them later.
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Security boundary: JWTs issued before this instant are rejected.
  passwordChangedAt DateTime? @map("password_changed_at")

  // When true, the user must define a new password before using the API again.
  mustChangePassword Boolean @default(false) @map("must_change_password")

  properties          Property[]
  photoBatches        PropertyPhotoBatch[]
  revokedTokens       RevokedToken[]
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]

  @@index([createdAt, id])
  @@map("users")
}

// A capture is assigned to an active system user: ADMIN or PARTNER. The
// property owner is an external contact and deliberately has no User account.
model Property {
  id           Int            @id @default(autoincrement())
  agentId      Int            @map("agent_id")
  code         String         @unique @default(dbgenerated("('HK-' || lpad(nextval('property_code_seq')::text, 4, '0'))")) @db.VarChar(50)
  title        String         @db.VarChar(200)
  propertyType PropertyType   @map("property_type")
  listingType  ListingType    @map("listing_type")
  status       PropertyStatus @default(ACTIVE)
  description  String?        @db.Text

  ownerName  String  @map("owner_name") @db.VarChar(150)
  ownerPhone String  @map("owner_phone") @db.VarChar(20)
  ownerEmail String? @map("owner_email") @db.Citext

  address      String  @db.Text
  neighborhood String? @db.VarChar(100)
  city         String  @db.VarChar(100)
  state        String  @db.VarChar(100)
  latitude     Decimal @db.Decimal(10, 7)
  longitude    Decimal @db.Decimal(10, 7)

  price          Decimal  @db.Decimal(12, 2)
  currency       Currency @default(USD)
  maintenanceFee Decimal? @map("maintenance_fee") @db.Decimal(12, 2)
  isNegotiable   Boolean  @default(false) @map("is_negotiable")

  bedrooms        Int
  bathrooms       Int
  parkingSpaces   Int      @map("parking_spaces")
  squareMeters    Decimal  @map("square_meters") @db.Decimal(10, 2)
  lotSquareMeters Decimal? @map("lot_square_meters") @db.Decimal(12, 2)
  yearBuilt       Int?     @map("year_built")
  apartmentFloor  Int?     @map("apartment_floor")

  hasWaterTank       Boolean @default(false) @map("has_water_tank")
  hasPowerPlant      Boolean @default(false) @map("has_power_plant")
  isFurnished        Boolean @default(false) @map("is_furnished")
  allowsPets         Boolean @default(false) @map("allows_pets")
  hasPool            Boolean @default(false) @map("has_pool")
  hasGym             Boolean @default(false) @map("has_gym")
  hasBalcony         Boolean @default(false) @map("has_balcony")
  hasAirConditioning Boolean @default(false) @map("has_air_conditioning")
  hasSecurity        Boolean @default(false) @map("has_security")
  hasElevator        Boolean @default(false) @map("has_elevator")

  videoUrl       String? @map("video_url") @db.Text
  virtualTourUrl String? @map("virtual_tour_url") @db.Text

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  agent  User    @relation(fields: [agentId], references: [id])
  photos Photo[]

  @@index([agentId, createdAt])
  @@index([status, listingType, propertyType])
  @@index([state, city])
  @@index([createdAt, id])
  @@map("properties")
}

// Binary content lives in object storage. PostgreSQL only keeps the durable
// object key and metadata needed to authorize, order and render each photo.
model Photo {
  id         Int     @id @default(autoincrement())
  propertyId Int     @map("property_id")
  storageKey String  @unique @map("storage_key") @db.VarChar(500)
  mimeType   String  @map("mime_type") @db.VarChar(100)
  sizeBytes  Int     @map("size_bytes")
  width      Int
  height     Int
  altText    String? @map("alt_text") @db.VarChar(300)
  sortOrder  Int     @default(0) @map("sort_order")
  isCover    Boolean @default(false) @map("is_cover")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // A separate partial unique index guarantees one cover per property.
  @@index([propertyId, sortOrder])
  @@map("photos")
}

// Photos are uploaded and validated before the capture exists. Only READY
// uploads from an OPEN batch owned by the actor can be attached atomically.
model PropertyPhotoBatch {
  id        String                   @id @default(uuid()) @db.Uuid
  userId    Int                      @map("user_id")
  status    PropertyPhotoBatchStatus @default(OPEN)
  expiresAt DateTime                 @map("expires_at")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")

  user    User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  uploads PropertyPhotoUpload[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("property_photo_batches")
}

model PropertyPhotoUpload {
  id         String                    @id @default(uuid()) @db.Uuid
  batchId    String                    @map("batch_id") @db.Uuid
  storageKey String                    @unique @map("storage_key") @db.VarChar(500)
  mimeType   String                    @map("mime_type") @db.VarChar(100)
  sizeBytes  Int                       @map("size_bytes")
  width      Int
  height     Int
  altText    String?                   @map("alt_text") @db.VarChar(300)
  sortOrder  Int                       @default(0) @map("sort_order")
  status     PropertyPhotoUploadStatus @default(READY)
  consumedAt DateTime?                 @map("consumed_at")
  createdAt  DateTime                  @default(now()) @map("created_at")
  updatedAt  DateTime                  @updatedAt @map("updated_at")

  batch PropertyPhotoBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, status, sortOrder])
  @@map("property_photo_uploads")
}

model RevokedToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("revoked_tokens")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash") @db.VarChar(64)
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)

  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("password_reset_tokens")
}

// Previous password hashes used to reject reuse of the last N passwords. Rows
// are pruned after every password change and deleted with the user.
model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

// Durable email queue. Emails are inserted in the same transaction as the
// business change and delivered by a background worker with retries.
model EmailOutbox {
  id            Int               @id @default(autoincrement())
  type          EmailType
  to            String            @db.VarChar(255)
  payload       Json
  status        EmailOutboxStatus @default(PENDING)
  attempts      Int               @default(0)
  maxAttempts   Int               @default(5) @map("max_attempts")
  nextAttemptAt DateTime          @default(now()) @map("next_attempt_at")
  lockedAt      DateTime?         @map("locked_at")
  lastError     String?           @map("last_error") @db.VarChar(500)
  sentAt        DateTime?         @map("sent_at")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@index([createdAt])
  @@map("email_outbox")
}

// Persistent brute-force protection keyed by the submitted email, including
// emails that do not belong to any account. Because the row exists for unknown
// emails too, a locked response never reveals whether an account exists.
model LoginAttempt {
  email          String    @id @db.VarChar(255)
  failedAttempts Int       @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@map("login_attempts")
}

// Append-only security and business activity log. It deliberately has no
// foreign keys so deleting a user never deletes the history of their actions.
model AuditLog {
  id         Int        @id @default(autoincrement())
  scope      AuditScope
  actorId    Int?       @map("actor_id")
  actorRole  Role?      @map("actor_role")
  actorEmail String?    @map("actor_email") @db.VarChar(255)
  action     String     @db.VarChar(80)
  entityType String?    @map("entity_type") @db.VarChar(40)
  entityId   Int?       @map("entity_id")
  changes    Json?
  ip         String?    @db.VarChar(45)
  userAgent  String?    @map("user_agent") @db.VarChar(512)
  requestId  String?    @map("request_id") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt, id])
  @@index([actorId, createdAt])
  @@index([scope, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_logs")
}
